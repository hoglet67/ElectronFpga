;============================================================
; ElectronFPGA integration of the ADS1115
;============================================================

; INPUTS
; 0 = start conversion (active high)

; OUTPUTS
; 0 = conversion in progress (active high)

; This program does the following:
;
;
; while (true) {
;     Wait for start conversion trigger
;     Wait 2.5ms for conversion
;     Read ADC result => external registers 4 and 0
;
; }

; I2C clock rate is 100MHz, so DELAYs are in 10us units

;============================================================
; Notes for the ADS1115
;============================================================

; Device address is 0x50 (so 0xA0 for writes and 0xA1 for reads)

; Config register is:
;
;       15 = OS        (1 = start conversion)
; 14 .. 12 = MUX       (100 = Ch0 ... 111 = Ch3)
; 11 ..  9 = PGA       (010 = FS +/- 2.048V)
;        8 = MODE      (0 = Cont, 1 = One Shot)
;  7 ..  5 = DR        (111 = 860SPS)
;        4 = COMP_MODE (0 = Traditional comparator, 1 = Windowed comparator)
;        3 = COMP_POL  (0 = Active low, 1 = Active high)
;        2 = COMP_LAT  (0 = Not latching ALERT, 1 = Latching ALERT)
;     1..0 = COMP_QUE  (11 = ALERT after 4 conversions)


;============================================================
; Main program
;============================================================

runloop:

        NOP
        NOP

        CLEAR 0

waitloop:
        SKIPSET 0
        JUMP waitloop

        SET 0

        WRITE 0x90 ; Device address + write
        WRITE 0x01 ; Select config register
        WRITELOW   ; Config MSB C5/D5/E5/F5
        WRITE 0xE3 ; Config LSB
        STOP       ; End tx

        DELAY 256  ; wait ~2.5ms for conversion

        WRITE 0x90 ; Device address + write
        WRITE 0x00 ; Select conversion register
        STOP
        WRITE 0x91 ; Device address + read
        MASTERACK
        READ  0
        READ  1
        STOP

        JUMP runloop
